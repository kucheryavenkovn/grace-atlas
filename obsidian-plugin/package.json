{
  "name": "grace-workbench",
  "version": "0.4.0",
  "description": "GRACE Workbench — Rose-like read-only CASE shell for GRACE Atlas snapshots",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": ["obsidian", "grace", "workbench", "traceability"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.7.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "cytoscape": "^3.30.0",
    "elkjs": "^0.9.3"
  }
}
