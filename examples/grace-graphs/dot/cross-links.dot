digraph G {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, label="GRACE CrossLinks (knowledge-graph)", labelloc=t, overlap=false, splines=true, newrank=true];
  node [shape=box, style="rounded,filled", fillcolor="#E8F1FF", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_module {
    label="module";
    style=rounded;
    bgcolor="#E8F1FF";
    M_CORE [label="M-CORE"];
    M_HELPER [label="M-HELPER"];
  }


  M_HELPER -> M_CORE [label="uses helper utilities"];
}
