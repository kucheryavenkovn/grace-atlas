digraph G {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, label="GRACE Module Dependencies", labelloc=t, overlap=false, splines=true, newrank=true];
  node [shape=box, style="rounded,filled", fillcolor="#E8F1FF", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_CORE_LOGIC {
    label="CORE_LOGIC";
    style=rounded;
    bgcolor="#BBDEFB";
    M_CORE [label="M-CORE\\nCore\\n[implemented]"];
  }

  subgraph cluster_UTILITY {
    label="UTILITY";
    style=rounded;
    bgcolor="#E0E0E0";
    M_HELPER [label="M-HELPER\\nHelper\\n[implemented]"];
    M_UNVERIFIED [label="M-UNVERIFIED\\nUnverified\\n[implemented]"];
  }


  M_HELPER -> M_CORE [label="depends_on"];
  M_UNVERIFIED -> M_CORE [label="depends_on"];
}
