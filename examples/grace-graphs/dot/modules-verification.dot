digraph G {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, label="GRACE Modules ↔ Verification", labelloc=t, overlap=false, splines=true, newrank=true];
  node [shape=box, style="rounded,filled", fillcolor="#E8F1FF", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_module {
    label="module";
    style=rounded;
    bgcolor="#E8F1FF";
    M_CORE [label="M-CORE\\nCore"];
    M_HELPER [label="M-HELPER\\nHelper"];
    M_MISSING_FILE [label="M-MISSING-FILE\\nMissingFile"];
    M_UNVERIFIED [label="M-UNVERIFIED\\nUnverified"];
  }

  subgraph cluster_verification {
    label="verification";
    style=rounded;
    bgcolor="#F3E8FF";
    V_M_CORE [label="V-M-CORE\\n[passed]"];
    V_M_HELPER [label="V-M-HELPER\\n[passed]"];
  }


  M_CORE -> V_M_CORE [label="verified_by"];
  M_HELPER -> V_M_HELPER [label="verified_by"];
  M_MISSING_FILE -> V_M_CORE [label="verified_by"];
}
